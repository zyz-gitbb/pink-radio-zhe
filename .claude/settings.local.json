{
  "permissions": {
    "allow": [
      "Bash(gh *)",
      "Bash(winget install *)",
      "PowerShell(gh *)",
      "Bash(npm run *)",
      "Bash(npx tsc *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\.claude\\statusline.ps1",
    "padding": 0,
    "refreshInterval": 5
  }
}
