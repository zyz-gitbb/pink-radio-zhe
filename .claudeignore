# 1. 第三方依赖包（最可怕的 Token 杀手，绝对不能读！）
node_modules/
venv/
env/
.env_python/

# 2. 编译和打包生成的产物（机器看的，不需要 AI 去读）
dist/
build/
out/
.next/
.nuxt/

# 3. 日志文件（体积巨大且无用）
*.log
npm-debug.log*
yarn-debug.log*

# 4. 本地数据库文件
*.sqlite
*.db

# 5. 版本控制系统文件
.git/
.svn/

# 6. 包含个人隐私或密码的配置文件（保护你的账号安全！）
.env
.env.local
*.pem
